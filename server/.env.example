# === Base de données ===
DATABASE_URL="mysql://user:password@host:4000/dbname?ssl={\"rejectUnauthorized\":true}"

# === Auth (connexion via Google) ===
JWT_SECRET="change-me"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_GOOGLE_CLIENT_ID=""
# Ton propre identifiant Google (le "sub" de ton compte) — te rend admin
# automatiquement. Laisse vide au début, on le remplit après ta 1ère connexion.
OWNER_OPEN_ID=""

# === Stripe (backend) ===
# Récupère ces valeurs sur https://dashboard.stripe.com/apikeys (mode test d'abord)
STRIPE_SECRET_KEY="sk_test_..."
# Générée par `stripe listen` en local, ou par le endpoint webhook créé
# sur https://dashboard.stripe.com/webhooks en production
STRIPE_WEBHOOK_SECRET="whsec_..."

# === Stripe (frontend) ===
# Clé publique, sans risque à exposer côté client
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# === Divers ===
PORT=3000
